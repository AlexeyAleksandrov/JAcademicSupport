# Скопируй этот файл в .env и заполни значения

# Base64-токен авторизации GigaChat (из личного кабинета developers.sber.ru)
GIGACHAT_API_TOKEN=

# Строка подключения к PostgreSQL
# Формат: postgresql://user:password@host:port/dbname
DB_URL=postgresql://postgres:password@localhost:5432/AcademicSupport

# Опционально: переопределить модель или scope
# GIGACHAT_MODEL=GigaChat
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
